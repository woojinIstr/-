APP_ENV=development
APP_MODE=supabase
SQLITE_PATH=nextmeal.local.db
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# auto: 공개키 검증 가능 시 재사용 / remote: 매 요청 Supabase 사용자 확인
AUTH_VERIFICATION=auto
# OpenRouter 무료 모델 추천. 비워두면 기본 추천을 사용합니다.
OPENROUTER_API_KEY=
# 선택 사항. 생략하면 기본 무료 모델을 사용합니다.
OPENROUTER_MODEL=
