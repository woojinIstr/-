APP_ENV=development
APP_MODE=supabase
SQLITE_PATH=nextmeal.local.db
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# auto: 공개키 검증 가능 시 재사용 / remote: 매 요청 Supabase 사용자 확인
AUTH_VERIFICATION=auto
# Optional. Leave empty to use recommendations without calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
